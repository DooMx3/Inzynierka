\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}

% Set langage to english so sections like Table of content are labeled correctly:
% If you want to use polish change "english" to "polish" there
\usepackage[english]{babel}

% Proper formating of urls:
\usepackage{url}

 % FloatBarrier:
\usepackage{placeins}

% Todo notes to be used like:
% \todo[inline]{text}
\usepackage{todonotes}
\usepackage{float}

% Tables with more than one page:
\usepackage{longtable}

% For custom column types in tables, e.g. for centering text in a column with fixed width:
\usepackage{array}

% 2.1 thesis structure:
% Paragraph indent and spacing:
\setlength{\parskip}{0pt}
\setlength{\parindent}{0.85cm}

% Add dot after section number:
\renewcommand{\thesubsection}{\thesection\arabic{subsection}.}
\renewcommand{\thesection}{\arabic{section}.}

% 2.2 Margins:
\usepackage[top=2.5cm, bottom=2.0cm, inner=3.5cm, outer=2.0cm, includefoot]{geometry}

% 2.3 Font:
% Font size set in first line of main.tex
% Text is justified by default, so no need to set it explicitly
% Sections are bold by default, so no need to set it explicitly too
\linespread{1.5}

% 2.4 Figures, 2.5 Tables and 2.6 Equations:

% Add section number before figure/table number:
\renewcommand{\thefigure}{\arabic{section}.\arabic{figure}}
\renewcommand{\thetable}{\arabic{section}.\arabic{table}}
\renewcommand{\theequation}{\arabic{section}.\arabic{equation}}

\usepackage[skip=6pt,font=small]{caption} % Small is 10pt size

\usepackage{booktabs}
\usepackage{graphicx}
\usepackage{wrapfig}

%zamiana formatu na potrzeby pracy inżynierskiej/magisterskiej POLLUB
\makeatletter
\renewcommand{\@makecaption}[2]{%
	\vspace{\abovecaptionskip}%
	\sbox{\@tempboxa}{#1. #2}
	\ifdim \wd\@tempboxa >\hsize
	#1. #2\par
	\else
	\global\@minipagefalse
	\hbox to \hsize {\hfil #1. #2\hfil}%
	\fi
	\vspace{\belowcaptionskip}}
\makeatother
\makeatletter
\let\@afterindentfalse\@afterindenttrue
\@afterindenttrue
\makeatother

% Remove subsubsection numbering and not include it in table of content:
\setcounter{secnumdepth}{2}
\setcounter{tocdepth}{2}


% Set bibliography style to match non stadnard Pollub requirements:
\bibliographystyle{plain}

% Add hyperlinks to Table of content, citations, figures and tables:
\usepackage{hyperref}
