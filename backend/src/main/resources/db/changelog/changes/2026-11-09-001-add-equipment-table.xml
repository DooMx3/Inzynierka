<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="DooMx3" id="2026-11-09-001-add-equipment-table">
        <createTable tableName="equipment">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="equipment_pk"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="end_of_technical_inspection" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="equipment"
            baseColumnNames="organisation_id"
            referencedTableName="organisation"
            referencedColumnNames="id"
            constraintName="fk_equipment_organisation"/>
    </changeSet>
</databaseChangeLog>
