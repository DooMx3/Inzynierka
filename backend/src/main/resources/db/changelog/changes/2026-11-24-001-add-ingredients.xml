<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="2026-11-24-001-add-ingredients" author="copilot">
        <createSequence sequenceName="ingredient_number_seq" startValue="1" incrementBy="1"/>
        <createTable tableName="ingredient">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ingredient_pk"/>
            </column>
            <column name="ingredient_number" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_ingredient_number"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="energy_content" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="fat" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="saturated_fatty_acids" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="carbs" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="sugars" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="protein" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="salt" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="fibers" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="ingredient" baseColumnNames="organisation_id"
                constraintName="fk_ingredient_organisation"
                referencedTableName="organisation" referencedColumnNames="id"/>

        <createTable tableName="batch_ingredient">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="batch_ingredient_pk"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ingredient_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_grams" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="batch_ingredient" baseColumnNames="organisation_id"
                constraintName="fk_batch_ingredient_organisation"
                referencedTableName="organisation" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="batch_ingredient" baseColumnNames="batch_id"
                constraintName="fk_batch_ingredient_batch"
                referencedTableName="batch" referencedColumnNames="id"/>
        <addForeignKeyConstraint
                baseTableName="batch_ingredient" baseColumnNames="ingredient_id"
                constraintName="fk_batch_ingredient_ingredient"
                referencedTableName="ingredient" referencedColumnNames="id"/>
        <createIndex tableName="batch_ingredient" indexName="idx_batch_ingredient_batch">
            <column name="batch_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
