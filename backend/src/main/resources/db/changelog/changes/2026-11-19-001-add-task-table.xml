<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="DooMx3" id="2026-11-19-001-add-task-table">
        <createTable tableName="task">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="taskPK"/>
            </column>
            <column name="organisationId" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="createdById" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="creatorRoleAtCreation" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="assignedToId" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="taskType" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="fieldId" type="UUID"/>
            <column name="equipmentId" type="UUID"/>
            <column name="substanceId" type="UUID"/>
            <column name="startedAt" type="DATE"/>
            <column name="completedAt" type="DATE"/>
            <column name="dueDate" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="organisationId"
            referencedTableName="organisation"
            referencedColumnNames="id"
            constraintName="fk_task_organisation"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="createdById"
            referencedTableName="_user"
            referencedColumnNames="id"
            constraintName="fk_task_created_by"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="assignedToId"
            referencedTableName="_user"
            referencedColumnNames="id"
            constraintName="fk_task_assigned_to"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="fieldId"
            referencedTableName="field"
            referencedColumnNames="id"
            constraintName="fk_task_field"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="equipmentId"
            referencedTableName="equipment"
            referencedColumnNames="id"
            constraintName="fk_task_equipment"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="substanceId"
            referencedTableName="substance"
            referencedColumnNames="id"
            constraintName="fk_task_substance"/>
        <addCheckConstraint
            tableName="task"
            constraintName="chk_task_type"
            checkConstraint="taskType IN ('GENERAL', 'SPRAYING', 'HARVEST', 'FIELD_WORK', 'EQUIPMENT_MAINTENANCE')"/>
        <addCheckConstraint
            tableName="task"
            constraintName="chk_task_type_relations"
            checkConstraint="(taskType = 'GENERAL') OR (taskType = 'SPRAYING' AND fieldId IS NOT NULL AND substanceId IS NOT NULL) OR (taskType IN ('HARVEST', 'FIELD_WORK') AND fieldId IS NOT NULL AND substanceId IS NULL) OR (taskType = 'EQUIPMENT_MAINTENANCE' AND fieldId IS NULL AND equipmentId IS NOT NULL AND substanceId IS NULL)"/>
        <createIndex tableName="task" indexName="idx_task_organisation_due">
            <column name="organisationId"/>
            <column name="dueDate"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_assigned_to">
            <column name="assignedToId"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_created_by">
            <column name="createdById"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
