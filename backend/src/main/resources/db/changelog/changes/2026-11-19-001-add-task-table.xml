<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet author="DooMx3" id="2026-11-19-001-add-task-table">
        <createTable tableName="bottling">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bottlingPK"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="batch_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="quantity" type="NUMERIC(10,2)">
                <constraints nullable="false"/>
            </column>
            <column name="bottled_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="bottling" baseColumnNames="organisation_id" referencedTableName="organisation" referencedColumnNames="id" constraintName="fk_bottling_organisation"/>
        <addForeignKeyConstraint baseTableName="bottling" baseColumnNames="batch_id" referencedTableName="batch" referencedColumnNames="id" constraintName="fk_bottling_batch"/>
        <createTable tableName="record">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="recordPK"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="batch_id" type="UUID"/>
            <column name="sugar_level" type="NUMERIC(6,2)"/>
            <column name="acidity" type="NUMERIC(5,2)"/>
            <column name="ph" type="NUMERIC(4,2)"/>
            <column name="alcohol_content" type="NUMERIC(4,2)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="record" baseColumnNames="organisation_id" referencedTableName="organisation" referencedColumnNames="id" constraintName="fk_record_organisation"/>
        <addForeignKeyConstraint baseTableName="record" baseColumnNames="batch_id" referencedTableName="batch" referencedColumnNames="id" constraintName="fk_record_batch"/>
        <createTable tableName="task">
            <column name="id" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="taskPK"/>
            </column>
            <column name="organisation_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_by_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="creator_role_at_creation" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="assigned_to_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="task_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)"/>
            <column name="field_id" type="UUID"/>
            <column name="equipment_id" type="UUID"/>
            <column name="substance_id" type="UUID"/>
            <column name="batch_id" type="UUID"/>
            <column name="bottling_id" type="UUID"/>
            <column name="record_id" type="UUID"/>
            <column name="started_at" type="DATE"/>
            <column name="completed_at" type="DATE"/>
            <column name="due_date" type="DATE"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="organisation_id"
            referencedTableName="organisation"
            referencedColumnNames="id"
            constraintName="fk_task_organisation"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="created_by_id"
            referencedTableName="_user"
            referencedColumnNames="id"
            constraintName="fk_task_created_by"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="assigned_to_id"
            referencedTableName="_user"
            referencedColumnNames="id"
            constraintName="fk_task_assigned_to"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="field_id"
            referencedTableName="field"
            referencedColumnNames="id"
            constraintName="fk_task_field"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="equipment_id"
            referencedTableName="equipment"
            referencedColumnNames="id"
            constraintName="fk_task_equipment"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="substance_id"
            referencedTableName="substance"
            referencedColumnNames="id"
            constraintName="fk_task_substance"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="batch_id"
            referencedTableName="batch"
            referencedColumnNames="id"
            constraintName="fk_task_batch"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="bottling_id"
            referencedTableName="bottling"
            referencedColumnNames="id"
            constraintName="fk_task_bottling"/>
        <addForeignKeyConstraint
            baseTableName="task"
            baseColumnNames="record_id"
            referencedTableName="record"
            referencedColumnNames="id"
            constraintName="fk_task_record"/>
        <sql>
            ALTER TABLE task
            ADD CONSTRAINT chk_task_type
            CHECK (task_type IN ('GENERAL', 'SPRAYING', 'HARVEST', 'FIELD_WORK', 'EQUIPMENT_MAINTENANCE'))
        </sql>
        <sql>
            ALTER TABLE task
            ADD CONSTRAINT chk_task_type_relations
            CHECK (
                task_type = 'GENERAL'
                OR (task_type = 'SPRAYING'
                    AND field_id IS NOT NULL
                    AND substance_id IS NOT NULL
                    AND batch_id IS NULL
                    AND bottling_id IS NULL
                    AND record_id IS NULL)
                OR (task_type IN ('HARVEST', 'FIELD_WORK')
                    AND field_id IS NOT NULL
                    AND substance_id IS NULL
                    AND batch_id IS NULL
                    AND bottling_id IS NULL
                    AND record_id IS NULL)
                OR (task_type = 'EQUIPMENT_MAINTENANCE'
                    AND field_id IS NULL
                    AND equipment_id IS NOT NULL
                    AND substance_id IS NULL
                    AND batch_id IS NULL
                    AND bottling_id IS NULL
                    AND record_id IS NULL)
            )
        </sql>
        <createIndex tableName="task" indexName="idx_task_organisation_due">
            <column name="organisation_id"/>
            <column name="due_date"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_assigned_to">
            <column name="assigned_to_id"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_created_by">
            <column name="created_by_id"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_batch">
            <column name="batch_id"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_bottling">
            <column name="bottling_id"/>
        </createIndex>
        <createIndex tableName="task" indexName="idx_task_record">
            <column name="record_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
